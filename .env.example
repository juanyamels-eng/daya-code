# DAYA Code — environment configuration
# Copy this file to .env and fill in the keys you need.

# --- Provider selection (overrides --provider and --model flags) ---
# DAYA_PROVIDER=anthropic
# DAYA_MODEL=claude-sonnet-4-5

# --- API keys (only the one matching the chosen provider is required) ---

# Anthropic (Claude). Get one at https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (GPT). Get one at https://platform.openai.com/
# OPENAI_API_KEY=sk-...

# OpenRouter (any model). Get one at https://openrouter.ai/keys
# OPENAI_API_KEY=sk-or-...

# DAYA (native DAYA endpoint). https://api.daya.ai/v1
# DAYA_API_KEY=daya-...
