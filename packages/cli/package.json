{
  "name": "daya-code",
  "version": "0.1.0",
  "description": "Terminal code agent connected to the DAYA suite — AI images, web search, documents, persistent memory",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "daya": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/juanyamels-eng/daya-code"
  },
  "keywords": [
    "ai",
    "cli",
    "code-agent",
    "terminal",
    "mcp",
    "daya",
    "code-generation",
    "developer-tools"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/postbuild.js",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@daya-code/core": "^0.1.0",
    "ink": "^5.0.1",
    "ink-text-input": "^6.0.0",
    "ink-spinner": "^5.0.0",
    "react": "^18.3.1",
    "meow": "^13.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  }
}
